generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model QuoteRequest {
  id          String   @id @default(cuid())
  name        String
  phone       String
  service     String
  preferDate  String?
  detail      String?
  imageUrls   String[] @default([])
  status      Status   @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("quote_requests")
}

enum Status {
  PENDING
  CONTACTED
  SCHEDULED
  COMPLETED
  CANCELLED
}
